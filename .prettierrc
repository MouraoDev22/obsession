{
  "arrowParens": "always",
  "importOrder": [
    "\\.json$",
    "",
    "<TYPES>",
    "",
    "<BUILTIN_MODULES>",
    "",
    "^react$",
    "^next",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^(?!.*\\.css$).*(?:^|/)components/",
    "",
    "^(?!.*\\.css$).*(?:^|/)utils/",
    "",
    "^(?!.*\\.css$)[./]",
    "",
    "\\.css$"
  ],
  "importOrderParserPlugins": ["typescript", "jsx", "tsx", "decorators-legacy"],
  "importOrderSafeSideEffects": ["^.*\\.css$"],
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-css-order",
    "prettier-plugin-packagejson",
    "prettier-plugin-sort-json"
  ],
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all"
}
